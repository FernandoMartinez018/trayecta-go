# Variables del backend. Copia este archivo a entorno-local/.env.backend para el entorno local.
# Nunca pongas valores reales de un despliegue en archivos del repositorio.

ENTORNO=local
PUERTO=8080

DB_URL=jdbc:postgresql://postgres:5432/trayecta
DB_USUARIO=trayecta
DB_CLAVE=solo-local

# iss que traen los tokens (KC_HOSTNAME de Keycloak) y de dónde se descargan las llaves.
OIDC_ISSUER=http://host.docker.internal:8081/realms/trayecta-go
OIDC_JWKS_URL=http://keycloak:8080/realms/trayecta-go/protocol/openid-connect/certs
OIDC_AUDIENCIA=trayecta-go-api
